solve(matrix(0.001,D,D))
L2 <- array(rep(diag(D)*0.001, T0), c(D,D,T0))
CVI_C0(N,D,T0,s1,s2,C00=diag(D), nu0 = D+1, V0 = solve(cov(X)), X=X1, W1,W2,L1,L2=array(0.001,c(D,D,T0)), Plog, nu=D+1, V = matrix(0.001, D, D))

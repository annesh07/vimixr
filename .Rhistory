library(vimixr)
devtools::load_all()
A <- matrix(1, 100, 1500)
B <- c(1:100)
microbenchmark::microbenchmark(Rfast::Crossprod(sweep(A, 1, B, "*"), A), Rfast::Crossprod(A*B, A), t_mat_mult(A, diag(B), A))
all.equal(Rfast::Crossprod(sweep(A, 1, B, "*"), A), Rfast::Crossprod(A*B, A))
all.equal(Rfast::Crossprod(sweep(A, 1, B, "*"), A), t_mat_mult(A, diag(B), A))
Rfast::Diag.matrix(100, B)
microbenchmark::microbenchmark(Rfast::Crossprod(sweep(A, 1, B, "*"), A), Rfast::Crossprod(A*B, A), t_mat_mult(A, diag(B), A), t_mat_mult(A, Rfast::Diag.matrix(100,B), A))
microbenchmark::microbenchmark(Rfast::Diag.matrix(1000, c(1:1000)), diag(c(1:1000)))
